    <Proxy group="filters" type="ProgrammableFilter" id="17097" servers="1">
      <Property name="CopyArrays" id="17097.CopyArrays" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="bool" id="17097.CopyArrays.bool"/>
      </Property>
      <Property name="InformationScript" id="17097.InformationScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Input" id="17097.Input" number_of_elements="1">
        <Proxy value="15616" output_port="0"/>
        <Domain name="groups" id="17097.Input.groups"/>
        <Domain name="input_type" id="17097.Input.input_type"/>
      </Property>
      <Property name="OutputDataSetType" id="17097.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="enum" id="17097.OutputDataSetType.enum">
          <Entry value="8" text="Same as Input"/>
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="10" text="vtkUniformGrid"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="32" text="vtkHyperTreeGrid"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PythonPath" id="17097.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="17097.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;from vtk.util import numpy_support as ns&#xa;&#xa;BIN = 2&#xa;Y0 = 111.0&#xa;SCALE = 3.5&#xa;&#xa;inp = self.GetInputDataObject(0, 0)&#xa;cd = inp.GetCellData()&#xa;&#xa;bx = ns.vtk_to_numpy(cd.GetArray(&#x27;bx&#x27;))&#xa;by = ns.vtk_to_numpy(cd.GetArray(&#x27;by&#x27;))&#xa;&#xa;ymin, ymax = float(by.min()), float(by.max())&#xa;start = np.floor(ymin / BIN) * BIN&#xa;end   = np.ceil(ymax / BIN) * BIN&#xa;nbins = int(round((end - start) / BIN))&#xa;&#xa;centers = start + (np.arange(nbins) + 0.5) * BIN&#xa;edges   = start + np.arange(nbins + 1) * BIN&#xa;counts, _ = np.histogram(by, bins=edges)&#xa;&#xa;x_mm = -((centers - Y0) / SCALE)&#xa;&#xa;&#xa;out = self.GetPolyDataOutput()&#xa;&#xa;pts = vtk.vtkPoints()&#xa;pts.SetNumberOfPoints(nbins)&#xa;for i in range(nbins):&#xa;    pts.SetPoint(i, float(x_mm[i]), float(counts[i]), 0.0)&#xa;out.SetPoints(pts)&#xa;&#xa;verts = vtk.vtkCellArray()&#xa;for i in range(nbins):&#xa;    verts.InsertNextCell(1)&#xa;    verts.InsertCellPoint(i)&#xa;out.SetVerts(verts)&#xa;&#xa;# Arrays en sortie (sur les points)&#xa;def add_array(name, data):&#xa;    arr = ns.numpy_to_vtk(np.ascontiguousarray(data, dtype=np.float64), deep=True)&#xa;    arr.SetName(name)&#xa;    out.GetPointData().AddArray(arr)&#xa;&#xa;add_array(&#x27;X_mm&#x27;,       x_mm)&#xa;add_array(&#x27;by_center&#x27;,  centers)&#xa;add_array(&#x27;Counts&#x27;,     counts.astype(np.float64))&#xa;add_array(&#x27;Counts_neg&#x27;, -counts.astype(np.float64))"/>
      </Property>
      <Property name="TimestepValues" id="17097.TimestepValues"/>
      <Property name="UpdateExtentScript" id="17097.UpdateExtentScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
    </Proxy>
