        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;from vtk.util import numpy_support as ns&#xa;&#xa;BIN = 2&#xa;Y0 = 111.0&#xa;SCALE = 3.1          # pixels per mm&#xa;RHO = 1754.0         # kg/m^3&#xa;&#xa;inp = self.GetInputDataObject(0, 0)&#xa;cd = inp.GetCellData()&#xa;&#xa;bx = ns.vtk_to_numpy(cd.GetArray(&#x27;bx&#x27;))&#xa;by = ns.vtk_to_numpy(cd.GetArray(&#x27;by&#x27;))&#xa;seg = ns.vtk_to_numpy(cd.GetArray(&#x27;SegmentationMean&#x27;))&#xa;&#xa;# mass per fragment: sphere of equivalent surface area&#xa;area_mm2 = seg / (SCALE * SCALE)          # px^2 -&#x3e; mm^2&#xa;r_mm = np.sqrt(area_mm2 / (4.0 * np.pi))  # 4*pi*r^2 = A&#xa;vol_mm3 = (4.0 / 3.0) * np.pi * r_mm**3&#xa;mass_mg = RHO * vol_mm3 * 1.0e-3          # kg/m^3 * mm^3 -&#x3e; mg&#xa;&#xa;ymin, ymax = float(by.min()), float(by.max())&#xa;start = np.floor(ymin / BIN) * BIN&#xa;end   = np.ceil(ymax / BIN) * BIN&#xa;nbins = int(round((end - start) / BIN))&#xa;&#xa;centers = start + (np.arange(nbins) + 0.5) * BIN&#xa;edges   = start + np.arange(nbins + 1) * BIN&#xa;masses, _ = np.histogram(by, bins=edges, weights=mass_mg)&#xa;&#xa;x_mm = -((centers - Y0) / SCALE)&#xa;&#xa;out = self.GetPolyDataOutput()&#xa;&#xa;pts = vtk.vtkPoints()&#xa;pts.SetNumberOfPoints(nbins)&#xa;for i in range(nbins):&#xa;    pts.SetPoint(i, float(x_mm[i]), float(masses[i]), 0.0)&#xa;out.SetPoints(pts)&#xa;&#xa;verts = vtk.vtkCellArray()&#xa;for i in range(nbins):&#xa;    verts.InsertNextCell(1)&#xa;    verts.InsertCellPoint(i)&#xa;out.SetVerts(verts)&#xa;&#xa;def add_array(name, data):&#xa;    arr = ns.numpy_to_vtk(np.ascontiguousarray(data, dtype=np.float64), deep=True)&#xa;    arr.SetName(name)&#xa;    out.GetPointData().AddArray(arr)&#xa;&#xa;add_array(&#x27;X_mm&#x27;,      x_mm)&#xa;add_array(&#x27;by_center&#x27;, centers)&#xa;add_array(&#x27;Mass_mg&#x27;,   masses)&#xa;add_array(&#x27;Mass_neg&#x27;,  -masses)"/>
      </Property>
      <Property name="TimestepValues" id="17108.TimestepValues"/>
      <Property name="UpdateExtentScript" id="17108.UpdateExtentScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
    </Proxy>
